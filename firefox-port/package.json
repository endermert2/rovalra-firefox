    "verify": "node verify.mjs",
    "test:firefox": "node test/firefox-smoke.mjs",
    "test:install": "node test/permanent-install.mjs"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "acorn-walk": "8.3.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "geckodriver": "6.1.1",
    "selenium-webdriver": "4.49.0",
    "web-ext": "10.6.0",
    "dompurify": "3.4.15"
  },
  "overrides": {
    "image-size": "2.0.4",
    "adm-zip": "0.6.1"
  }
}
