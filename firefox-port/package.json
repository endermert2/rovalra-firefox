{
  "name": "rovalra-firefox-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node adapter.mjs --source upstream",
    "update": "node update.mjs",
    "test": "node --test test/*.test.mjs",
